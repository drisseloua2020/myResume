+    try:
+        target.chmod(0o600)
+    except OSError:
+        pass
 
-    relative_path = Path("profile-photos") / current_user.id / filename
-    url = f"{settings.upload_url_prefix.rstrip('/')}/{relative_path.as_posix()}"
+    url = f"{settings.upload_url_prefix.rstrip('/')}/profile-photo/{filename}"
 
