APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./app.db
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
PORT=3000

# AI usage policy: deterministic/no-LLM operation by default.
# A future AI gateway must stay disabled unless this is explicitly true.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_PROVIDER=
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
