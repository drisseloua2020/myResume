APP_ENV=development
MOCK_PROVIDERS_ENABLED=false
DATABASE_URL=sqlite+pysqlite:///./app.db
# For Compose, replace DATABASE_URL with a PostgreSQL URL using host db:
# DATABASE_URL=postgresql+psycopg://myresume_owner:<POSTGRES_PASSWORD>@db:5432/myresumes
# Generate a separate secret for each environment. Never commit real values.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
# Preserve the existing MyResumes custom-domain/Render aliases when one is configured.
# Set false to enforce only the exact CORS_ORIGINS list.
INCLUDE_LEGACY_FRONTEND_ALIASES=true
OAUTH_FRONTEND_URL=http://localhost:4000
OAUTH_COOKIE_SECURE=false
UPLOAD_DIR=protected_uploads
FORWARDED_ALLOW_IPS=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com
POSTGRES_DB=myresumes
POSTGRES_USER=myresume_owner
POSTGRES_PASSWORD=replace-local-password
